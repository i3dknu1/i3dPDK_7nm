  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(AND2_X1) { 
    area : 0.042 ; 
    cell_leakage_power : 355.7 ; 

    leakage_power() { 
      when : "A1&A2" ; 
      value : "447.8" ; 
    }

    leakage_power() { 
      when : "!A1&!A2" ; 
      value : "355.7" ; 
    }

    leakage_power() { 
      when : "A1&!A2" ; 
      value : "465.3" ; 
    }

    leakage_power() { 
      when : "!A1&A2" ; 
      value : "468.8" ; 
    }
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    pin(A1) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 0.9158 ; 
      fall_capacitance_range(0.5303, 0.9158);
      input_signal_level : RAIL_VDD ; 
      capacitance : 0.9158 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 0.9131 ; 
      rise_capacitance_range(0.517, 0.9131);

      internal_power() { 

        rise_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("-0.1887, -0.1887, -0.1887, -0.1888, -0.1889, -0.189, -0.189");
        }

        fall_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("0.2882, 0.2882, 0.2881, 0.2882, 0.2883, 0.2882, 0.2883");
        }
      }
    }

    pin(A2) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 0.8476 ; 
      fall_capacitance_range(0.5933, 0.8476);
      input_signal_level : RAIL_VDD ; 
      capacitance : 0.877 ; 
      max_transition : 0.6 ; 
